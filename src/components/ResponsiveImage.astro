---
import type { HTMLAttributes } from "astro/types";
import { getResponsiveImage } from "../lib/images";

interface Props extends Omit<HTMLAttributes<"img">, "src" | "srcset"> {
  src: string;
  alt: string;
}

const { src, ...props } = Astro.props;
const image = await getResponsiveImage(src);
---

<img {...image.attributes} src={image.src} srcset={image.srcSet.attribute} {...props} />
