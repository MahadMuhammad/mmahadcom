<script>
  let controls: AbortController | undefined;

  function setupEmptyNotesTheme() {
    controls?.abort();
    const button = document.querySelector<HTMLButtonElement>('#notes-content[data-notes-library="empty"] [data-theme-toggle]');
    if (!button) return;

    controls = new AbortController();
    const { signal } = controls;
    const root = document.documentElement;
    const system = window.matchMedia("(prefers-color-scheme: dark)");
    const readPreference = () => {
      try {
        const saved = localStorage.getItem("mahad-theme");
        return saved === "light" || saved === "dark" ? saved : "system";
      } catch {
        return "system";
      }
    };
    let preference = readPreference();
    const resolvedTheme = () => (preference === "system" ? (system.matches ? "dark" : "light") : preference);
    const sync = () => {
      const dark = resolvedTheme() === "dark";
      root.classList.toggle("dark", dark);
      root.classList.toggle("light", !dark);
      root.style.colorScheme = dark ? "dark" : "light";
      button.setAttribute("aria-pressed", String(dark));
      for (const [index, icon] of [...button.querySelectorAll("svg")].entries()) {
        const active = index === (dark ? 1 : 0);
        icon.classList.toggle("bg-fd-accent", active);
        icon.classList.toggle("text-fd-accent-foreground", active);
        icon.classList.toggle("text-fd-muted-foreground", !active);
      }
    };
    const toggleTheme = () => {
      preference = resolvedTheme() === "dark" ? "light" : "dark";
      try {
        localStorage.setItem("mahad-theme", preference);
      } catch {
        // The control still works when the browser denies persistence.
      }
      sync();
    };
    button.addEventListener("click", toggleTheme, { signal });
    window.addEventListener(
      "keydown",
      (event) => {
        if (event.defaultPrevented || event.isComposing || event.keyCode === 229 || event.metaKey || event.ctrlKey || event.altKey) return;
        const target = event.target;
        if (
          target instanceof HTMLElement &&
          (target.isContentEditable || target.matches("input, textarea, select") || target.closest('[role="dialog"]'))
        )
          return;
        if (event.key.toLowerCase() !== "d") return;
        event.preventDefault();
        toggleTheme();
      },
      { signal }
    );
    system.addEventListener(
      "change",
      () => {
        if (preference === "system") sync();
      },
      { signal }
    );
    window.addEventListener(
      "storage",
      (event) => {
        if (event.key === "mahad-theme" || event.key === null) {
          preference = readPreference();
          sync();
        }
      },
      { signal }
    );
    sync();
  }

  setupEmptyNotesTheme();
  document.addEventListener("astro:page-load", setupEmptyNotesTheme);
  document.addEventListener("astro:before-swap", () => controls?.abort());
</script>
